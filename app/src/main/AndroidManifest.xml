<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal permission: lets the long-press menu's "Uninstall" action
         use ACTION_UNINSTALL_PACKAGE directly. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Signature-level; not actually grantable via this declaration. The
         user grants "Usage access" in Settings, checked at runtime via
         AppOpsManager. Declaring it here is just self-documentation and
         helps some OEM Settings implementations list the app correctly. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Signature-level; must be declared here for `adb shell pm grant` to
         have anything to grant. There is no in-app or Settings-UI path to
         it — see §5.7 of the build plan and GrayscaleUtil. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Package visibility (API 30+): declaring that we query LAUNCHER
      activities grants implicit visibility into every launchable app's
      MAIN/LAUNCHER activity, without requiring QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".QuietApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Quiet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Quiet.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Started by GestureAccessibilityService on top of a blocklisted
          app; not launched by any other app, so it doesn't need to be
          exported.
        -->
        <activity
            android:name=".ui.friction.FrictionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Quiet.Home" />

        <!--
          Bare-minimum accessibility service (see GestureAccessibilityService)
          used only for performGlobalAction — lock screen and expand
          notifications have no public API. The user enables it once in
          Settings; gestures degrade gracefully when it's off.
        -->
        <service
            android:name=".service.GestureAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Cancels notifications from muted apps. The user enables it once
          in Settings (Notification access); it degrades gracefully to
          doing nothing when off.
        -->
        <service
            android:name=".service.NotificationFilterService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
